<main class="login-page">

  <section class="login-card">
    <div class="login-image">
      <%= image_tag "cathedral.jpg", alt: "Interior catedral" %>

      <div class="login-image-overlay">
        <div class="brand">
          <span class="brand-name">SaintStudy</span>
          <span class="brand-description">Sistema de Gestão de Catequese Paroquial </span>
        </div>

        <p class="brand-message"> Gestão paroquial com a clareza, modernidade
          e o peso da tradição.
        </p>
      </div>
    </div>

    <div class="login-content">

      <div class="login-header">
        <h1>Bem-vindo ao Portal</h1>
        <p>Acesse sua conta.</p>
      </div>

      <form class="login-form">
        <div class="form-group">
          <label for="email"> E-mail </label>
          <input type="email" id="email" name="email" placeholder="email@exemplo.com">
        </div>

        <div class="form-group">

          <div class="password-header">
            <label for="password"> Senha </label>
            <a href="#"> Esqueci minha senha </a>
          </div>
          <input type="password" id="password" name="password" placeholder="••••••••">
        </div>

        <div class="remember">
          <input type="checkbox" id="remember" name="remember">
          <label for="remember"> Lembrar de mim </label>
        </div>

        <button type="submit" class="login-button"> Entrar </button>
      </form>

      <div class="login-divider">
        <span></span>
        <p>OU ENTRE COM</p>
        <span></span>
      </div>

      <div class="social-buttons">
        <button type="button" class="social-button"> Google </button>
        <button type="button" class="social-button"> Apple </button>
      </div>

      <div class="login-register"> 
      Não tem uma conta?
      <a href="#">Realizar Login</a>
      </div>
    </div>
  </section>
</main>