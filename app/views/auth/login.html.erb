<main class="login-page">

  <section class="login-card">

    <div class="login-image">
      <%= image_tag "cathedral.jpg", alt: "Interior catedral" %>

      <div class="login-image-overlay">
        <div class="brand">
          <span class="brand-name">SaintStudy</span>
          <span class="brand-description">
            Sistema de Gestão de Catequese Paroquial
          </span>
        </div>

        <p class="brand-message">
          Gestão paroquial com a clareza, modernidade
          e o peso da tradição.
        </p>
      </div>
    </div>

    <div class="login-content">

      <div class="login-header">
        <h1>Bem-vindo ao Portal</h1>
        <p>Acesse sua conta.</p>
      </div>

      <%= form_with url: auth_path, method: :post, local: true, class: "login-form" do |form| %>

        <div class="form-group">
          <%= form.label :email, "E-mail" %>

          <%= form.email_field :email,
                id: "email",
                placeholder: "nome@exemplo.com" %>
        </div>

        <div class="form-group">

          <div class="password-header">
            <%= form.label :senha, "Senha" %>

            <%= link_to "Esqueci minha senha", "#" %>
          </div>

          <%= form.password_field :senha, id: "password", placeholder: "••••••••" %>

        </div>

        <div class="remember">
          <%= form.check_box :remember, id: "remember" %>

          <%= form.label :remember, "Lembrar de mim" %>
        </div>

        <%= form.submit "Entrar", class: "login-button" %>

      <% end %>

      <div class="login-divider">
        <span></span>
        <p>OU ENTRE COM</p>
        <span></span>
      </div>

      <div class="social-buttons">
        <%= link_to "Google", "/auth/google_oauth2", class: "social-button" %>

        <%= link_to "Apple", "/auth/apple", class: "social-button" %>
      </div>

      <div class="login-register">
        Não tem uma conta?
        <%= link_to "Realizar Cadastro", "#" %>
      </div>

    </div>

  </section>

</main>