<main class="flex min-h-screen items-center justify-center bg-slate-100 px-6 py-10">

  <section
    class="
      grid
      w-full
      max-w-5xl
      overflow-hidden
      rounded-2xl
      bg-white
      shadow-xl
      md:grid-cols-2
    "
  >

    <!-- ======================================= -->
    <!-- LADO ESQUERDO - IMAGEM -->
    <!-- ======================================= -->

    <div class="relative hidden min-h-[650px] overflow-hidden md:block">

      <%= image_tag(
        "cathedral.jpg",
        alt: "Interior da catedral",
        class: "absolute inset-0 h-full w-full object-cover"
      ) %>

      <!-- Overlay escuro -->
      <div
        class="
          absolute
          inset-0
          bg-gradient-to-t
          from-slate-950/95
          via-slate-900/20
          to-transparent
        "
      ></div>

      <!-- Marca -->
      <div
        class="
          absolute
          bottom-10
          left-10
          right-10
          text-white
        "
      >

        <h2 class="text-3xl font-bold">
          SaintStudy
        </h2>

        <p class="mt-3 max-w-xs text-sm leading-6 text-white/85">
          Gestão paroquial com a clareza, modernidade
          e o peso da tradição.
        </p>

      </div>

    </div>


    <!-- ======================================= -->
    <!-- LADO DIREITO - LOGIN -->
    <!-- ======================================= -->

    <div
      class="
        flex
        min-h-[650px]
        items-center
        justify-center
        px-8
        py-12
        sm:px-12
        lg:px-16
      "
    >

      <div class="w-full max-w-sm">


        <!-- TÍTULO -->

        <header class="mb-8">

          <h1 class="text-3xl font-bold text-blue-950">
            Bem-vindo ao Portal
          </h1>

          <p class="mt-2 text-sm text-slate-500">
            Acesse sua conta.
          </p>

        </header>


        <!-- ======================================= -->
        <!-- FORMULÁRIO -->
        <!-- ======================================= -->

        <%= form_with(
          url: auth_path,
          method: :post,
          local: true,
          class: "space-y-5"
        ) do |form| %>


          <!-- EMAIL -->

          <div>

            <%= form.label(
              :email,
              "E-mail",
              class: "
                mb-2
                block
                text-xs
                font-semibold
                uppercase
                tracking-wide
                text-slate-600
              "
            ) %>

            <%= form.email_field(
              :email,
              placeholder: "nome@exemplo.com",
              class: "
                block
                h-12
                w-full
                rounded-lg
                border-0
                bg-slate-100
                px-4
                text-sm
                text-slate-700
                placeholder:text-slate-400
                focus:ring-2
                focus:ring-blue-800
              "
            ) %>

          </div>


          <!-- SENHA -->

          <div>

            <div class="mb-2 flex items-center justify-between">

              <%= form.label(
                :senha,
                "Senha",
                class: "
                  text-xs
                  font-semibold
                  uppercase
                  tracking-wide
                  text-slate-600
                "
              ) %>

              <%= link_to(
                "Esqueci minha senha",
                "#",
                class: "
                  text-xs
                  font-medium
                  text-amber-700
                  hover:underline
                "
              ) %>

            </div>


            <%= form.password_field(
              :senha,
              placeholder: "••••••••",
              class: "
                block
                h-12
                w-full
                rounded-lg
                border-0
                bg-slate-100
                px-4
                text-sm
                text-slate-700
                placeholder:text-slate-400
                focus:ring-2
                focus:ring-blue-800
              "
            ) %>

          </div>


          <!-- LEMBRAR DE MIM -->

          <label
            class="
              flex
              cursor-pointer
              items-center
              gap-2
              text-xs
              text-slate-500
            "
          >

            <%= form.check_box(
              :remember,
              class: "
                h-4
                w-4
                rounded
                border-slate-300
                text-blue-900
              "
            ) %>

            Lembrar de mim

          </label>


          <!-- BOTÃO -->

          <%= form.submit(
            "Entrar",
            class: "
              h-12
              w-full
              cursor-pointer
              rounded-lg
              border-0
              bg-blue-950
              text-sm
              font-semibold
              text-white
              shadow-md
              transition
              hover:bg-blue-900
              focus:ring-4
              focus:ring-blue-200
            "
          ) %>

        <% end %>


        <!-- ======================================= -->
        <!-- DIVISOR -->
        <!-- ======================================= -->

        <div class="my-7 flex items-center gap-4">

          <div class="h-px flex-1 bg-slate-200"></div>

          <span class="text-xs font-semibold text-slate-400">
            OU ENTRE COM
          </span>

          <div class="h-px flex-1 bg-slate-200"></div>

        </div>


        <!-- ======================================= -->
        <!-- LOGIN SOCIAL -->
        <!-- ======================================= -->

        <div class="grid grid-cols-2 gap-3">

          <%= button_to(
            "Google",
            "/auth/google_oauth2",
            method: :post,
            data: { turbo: false },
            form_class: "contents",
            class: "
              flex
              h-11
              w-full
              cursor-pointer
              items-center
              justify-center
              rounded-lg
              border
              border-slate-200
              bg-white
              text-sm
              text-slate-600
              transition
              hover:bg-slate-50
            "
          ) %>


          <button
            type="button"
            disabled
            title="Em breve"
            class="
              flex
              h-11
              cursor-not-allowed
              items-center
              justify-center
              rounded-lg
              border
              border-slate-200
              bg-white
              text-sm
              text-slate-400
              opacity-60
            "
          >
            Apple
          </button>

        </div>


        <!-- ======================================= -->
        <!-- CADASTRO -->
        <!-- ======================================= -->

        <p class="mt-8 text-center text-xs text-slate-500">

          Não tem uma conta?

          <%= link_to(
            "Realizar Cadastro",
            signup_path,
            class: "
              ml-1
              font-semibold
              text-amber-700
              hover:underline
            "
          ) %>

        </p>


      </div>

    </div>

  </section>

</main>