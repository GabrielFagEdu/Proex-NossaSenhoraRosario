<!DOCTYPE html>
<html>
  <head>
    <title>SaintStudy</title>

    <meta name="viewport" content="width=device-width,initial-scale=1">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
  </head>

  <body class="m-0 min-h-screen bg-slate-100">

    <% flash.each do |tipo, mensagem| %>
      <div class="
        fixed left-1/2 top-5 z-50
        w-full max-w-md
        -translate-x-1/2
        rounded-lg border px-4 py-3 text-sm shadow-lg
        <%= tipo.to_sym == :alert ?
          'border-red-200 bg-red-50 text-red-800' :
          'border-green-200 bg-green-50 text-green-800' %>
      ">
        <%= mensagem %>
      </div>
    <% end %>

    <%= yield %>

  </body>
</html>