<main class="flex min-h-screen items-center justify-center bg-slate-100 px-6 py-10">

  <section
    class="
      grid
      w-full
      max-w-5xl
      overflow-hidden
      rounded-2xl
      bg-white
      shadow-xl
      md:grid-cols-2
    "
  >

    <!-- ========================= -->
    <!-- IMAGEM -->
    <!-- ========================= -->

    <div class="relative hidden min-h-[650px] overflow-hidden md:block">

      <%= image_tag(
        "cathedral.jpg",
        alt: "Interior da catedral",
        class: "absolute inset-0 h-full w-full object-cover"
      ) %>

      <!-- Overlay -->
      <div
        class="
          absolute inset-0
          bg-gradient-to-t
          from-slate-950/90
          via-slate-900/20
          to-transparent
        "
      ></div>


      <!-- Marca -->
      <div class="absolute bottom-10 left-10 right-10 text-white">

        <h2 class="text-3xl font-bold">
          SaintStudy
        </h2>

        <p class="mt-3 max-w-xs text-sm leading-6 text-white/80">
          Gestão paroquial com a clareza, modernidade
          e o peso da tradição.
        </p>

      </div>

    </div>


    <!-- ========================= -->
    <!-- CADASTRO -->
    <!-- ========================= -->

    <div
      class="
        flex
        min-h-[650px]
        items-center
        justify-center
        px-8
        py-12
        sm:px-12
        lg:px-16
      "
    >

      <div class="w-full max-w-sm">

        <!-- TITULO -->

        <header class="mb-8">

          <h1 class="text-3xl font-bold text-blue-950">
            Bem-vindo ao Portal
          </h1>

          <p class="mt-2 text-sm text-slate-500">
            Crie sua conta.
          </p>

        </header>


        <!-- ========================= -->
        <!-- FORM -->
        <!-- ========================= -->

        <form class="space-y-5">

          <!-- EMAIL -->

          <div>

            <label
              for="email"
              class="
                mb-2
                block
                text-xs
                font-semibold
                uppercase
                tracking-wide
                text-slate-600
              "
            >
              E-mail ou telefone
            </label>

            <input
              id="email"
              name="email"
              type="email"
              placeholder="nome@exemplo.com"
              class="
                block
                h-12
                w-full
                rounded-lg
                border-0
                bg-slate-100
                px-4
                text-sm
                text-slate-700
                outline-none
                placeholder:text-slate-400
                focus:ring-2
                focus:ring-blue-800
              "
            >

          </div>


          <!-- SENHA -->

          <div>

            <label
              for="password"
              class="
                mb-2
                block
                text-xs
                font-semibold
                uppercase
                tracking-wide
                text-slate-600
              "
            >
              Senha
            </label>

            <div class="relative">

              <input
                id="password"
                name="password"
                type="password"
                placeholder="••••••••"
                class="
                  block
                  h-12
                  w-full
                  rounded-lg
                  border-0
                  bg-slate-100
                  px-4
                  pr-12
                  text-sm
                  text-slate-700
                  outline-none
                  placeholder:text-slate-400
                  focus:ring-2
                  focus:ring-blue-800
                "
              >


              <!-- ícone olho -->

              <button
                type="button"
                class="
                  absolute
                  right-4
                  top-1/2
                  -translate-y-1/2
                  text-slate-400
                  transition
                  hover:text-slate-600
                "
                aria-label="Mostrar senha"
              >

                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-4 w-4"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.5"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M2.25 12s3.75-6.75 9.75-6.75S21.75 12 21.75 12 18 18.75 12 18.75 2.25 12 2.25 12Z"
                  />
                  <circle cx="12" cy="12" r="2.25"/>
                </svg>

              </button>

            </div>

          </div>


          <!-- CONFIRMAR SENHA -->

          <div>

            <label
              for="password_confirmation"
              class="
                mb-2
                block
                text-xs
                font-semibold
                uppercase
                tracking-wide
                text-slate-600
              "
            >
              Confirmar senha
            </label>

            <div class="relative">

              <input
                id="password_confirmation"
                name="password_confirmation"
                type="password"
                placeholder="••••••••"
                class="
                  block
                  h-12
                  w-full
                  rounded-lg
                  border-0
                  bg-slate-100
                  px-4
                  pr-12
                  text-sm
                  text-slate-700
                  outline-none
                  placeholder:text-slate-400
                  focus:ring-2
                  focus:ring-blue-800
                "
              >


              <button
                type="button"
                class="
                  absolute
                  right-4
                  top-1/2
                  -translate-y-1/2
                  text-slate-400
                  transition
                  hover:text-slate-600
                "
                aria-label="Mostrar confirmação de senha"
              >

                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-4 w-4"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.5"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M2.25 12s3.75-6.75 9.75-6.75S21.75 12 21.75 12 18 18.75 12 18.75 2.25 12 2.25 12Z"
                  />
                  <circle cx="12" cy="12" r="2.25"/>
                </svg>

              </button>

            </div>

          </div>


          <!-- BOTÃO -->

          <button
            type="button"
            class="
              mt-2
              h-12
              w-full
              rounded-lg
              bg-blue-950
              text-sm
              font-semibold
              text-white
              shadow-md
              transition
              hover:bg-blue-900
              focus:outline-none
              focus:ring-4
              focus:ring-blue-200
            "
          >
            Entrar
          </button>

        </form>


        <!-- ========================= -->
        <!-- LOGIN -->
        <!-- ========================= -->

        <p class="mt-7 text-center text-xs text-slate-500">

          Já tem uma conta?

          <%= link_to(
            "Realizar Login",
            login_path,
            class: "
              ml-1
              font-semibold
              text-amber-700
              hover:underline
            "
          ) %>

        </p>

      </div>

    </div>

  </section>

</main>