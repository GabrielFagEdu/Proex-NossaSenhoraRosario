<main class="flex min-h-screen items-center justify-center bg-slate-100 px-6 py-10">
  <section class="w-full max-w-md rounded-2xl bg-white p-10 text-center shadow-xl">
    <h1 class="text-2xl font-bold text-blue-950">
      Olá, <%= pessoa_atual.nome %>!
    </h1>

    <p class="mt-2 text-sm text-slate-500">
      Você está conectado ao SaintStudy.
    </p>

    <%= button_to "Sair", logout_path, method: :delete,
          class: "mt-8 h-11 w-full cursor-pointer rounded-lg bg-blue-950 text-sm font-semibold text-white shadow-md transition hover:bg-blue-900" %>
  </section>
</main>
